# Tailscale admin console > Settings > General: tailnet name
TAILSCALE_TAILNET=
TAILSCALE_CLIENT_ID=
TAILSCALE_CLIENT_SECRET=

# Optional notification channels. Never commit these values.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Login username: MONITOR_USER (default admin). Password required for Docker / non-loopback binding (8+ characters).
MONITOR_USER=admin
MONITOR_PASSWORD=
POLL_INTERVAL_SEC=60

# Direct Node.js run defaults to 127.0.0.1:8787.
# MONITOR_BIND=127.0.0.1
# MONITOR_PORT=8787
# DATA_DIR=.data

# Additional hostnames only when accessing by a server IP / reverse proxy.
# MONITOR_ALLOWED_HOSTS=monitor.internal,192.168.0.20

# 알림 하단 "모니터링 열기" 버튼 주소. 팀원이 열 수 있는 주소(예: 이 PC의 Tailscale IP)로 지정하세요.
# 비우면 http://127.0.0.1:8787 이며, Telegram은 로컬 주소 버튼을 거부하므로 Tailscale 콘솔 버튼만 붙습니다.
# MONITOR_PUBLIC_URL=http://100.x.y.z:8787
